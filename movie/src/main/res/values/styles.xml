        <item name="color_theme">#004B93</item>
        <item name="color_theme_80">#CC004B93</item>
        <item name="color_theme_70">#B3004B93</item>
        <item name="color_theme_60">#99004B93</item>
        <item name="color_theme_50">#80004B93</item>
